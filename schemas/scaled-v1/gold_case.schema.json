    "acceptable_answers": {
      "type": "array"
    },
    "allowed_turns": {
      "type": "integer"
    },
    "as_of": {
      "type": "string"
    },
    "benchmark_version": {
      "type": "string"
    },
    "capability": {
      "type": "string"
    },
    "case_id": {
      "type": "string"
    },
    "difficulty": {
      "type": "string"
    },
    "evidence": {
      "type": "array"
    },
    "expected_behaviours": {
      "type": "array"
    },
    "failure_tags": {
      "type": "array"
    },
    "gold_event_ids": {
      "type": "array"
